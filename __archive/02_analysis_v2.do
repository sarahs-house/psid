/* 00. Program Set Up */
    clear all
    set more off
    cap log close

    set maxvar 32767

    cd "$root"

    local date = subinstr("`c(current_date)'", "/", "-", .)
    local time = subinstr("`c(current_time)'", ":", "-", .)
    local datetime = "`date'_`time'"
    log using "$root/_log/02_analysis_v2_`datetime'.log", replace


    * Load in data
    use "$root/01_family_structure_v4.dta"
    * N= 1,660,525

    preserve 

/* 01. Cleaning */
    drop ID
    rename ER30001 fam 
    label var fam "Family ID"
    rename ER30002 fam_number
    label var fam_number "Within Family Count"
    label var yr "Year"
    rename ER30003 role
    label var role "Relation to Head"

    * Kid Number
    sort fam fam_number yr

    egen min_kid = min(fam_number) if role == 3, by(fam)
    by fam: g kid_number = 1 if fam_number == min_kid
    drop min_kid

    egen min_kid = min(fam_number)  if role == 3 & kid_number != 1, by(fam)
    by fam: replace kid_number = 2 if fam_number == min_kid
    drop min_kid

    forvalues j = 3/25{
        egen min_kid = min(fam_number)  if role == 3 & kid_number == ., by(fam)
        by fam: replace kid_number = `j' if fam_number == min_kid
        drop min_kid
    }

    label var kid_number "Child ID within family"

    * famkid
    g famkid = fam*10000 + kid_number
    label var famkid "fam*10000 + kid_number"

/* 02. Age */
